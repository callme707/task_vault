{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskVault",
  "version": "1.0.0",
  "identifier": "com.local.taskvault",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "任务记录 · 工作台",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "visible": false,
        "center": true,
        "decorations": false,
        "backgroundColor": "#f2f4fa",
        "url": "index.html"
      },
      {
        "label": "quick",
        "title": "快速记录",
        "width": 620,
        "height": 300,
        "visible": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "backgroundColor": "#f6f8fd",
        "url": "quick.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
